# Secrets: API keys live only in .env
.env
.env.*
!.env.example

# Python environment
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.ruff_cache/

# System
.DS_Store

# Data: large raw files do not go in the repository (50 MB limit)
data/raw/**/*.jsonl
data/raw/**/*.json.gz
data/raw/**/*.parquet
*.zip

# Third-party labels (Dune Spellbook, BSL licence): downloaded by the script, not committed
data/archive/raw/labels/

# Working files of the flow census (one row per block): only the daily table is committed
data/archive/raw/cex_flows_eth.csv
data/archive/raw/cex_flows_tron.csv
data/archive/raw/cex_flows_*_by_address.csv

# Result of the last free amount requested from module 4
data/processed/m4_custom.csv

# EBA transparency exercise: the full files are downloaded again by module 6; only the extract is committed
data/raw/eba_te2025/
